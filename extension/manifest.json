{
  "manifest_version": 3,
  "name": "Voice Chess",
  "version": "1.0.0",
  "description": "Move pieces with your voice in Chess.com Puzzle Rush.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Voice Chess · Puzzle Rush",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [{
    "resources": ["recognizer.html"],
    "matches": ["https://www.chess.com/*"]
  }],
  "content_scripts": [{
    "matches": ["https://www.chess.com/puzzles/rush", "https://www.chess.com/puzzles/rush/*", "https://www.chess.com/puzzles/rush?*"],
    "js": ["bridge.js"],
    "world": "ISOLATED",
    "run_at": "document_idle"
  }, {
    "matches": ["https://www.chess.com/puzzles/rush", "https://www.chess.com/puzzles/rush/*", "https://www.chess.com/puzzles/rush?*"],
    "js": ["commands.js", "board.js", "speech.js", "content.js"],
    "world": "MAIN",
    "run_at": "document_idle"
  }]
}
